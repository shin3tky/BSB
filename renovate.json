{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "BSB の Unicode 16.0.0 仕様に合わせて ICU4J 76.1 に固定する。",
      "matchPackageNames": ["com.ibm.icu:icu4j"],
      "enabled": false
    },
    {
      "description": "LSP4J 1.0 の破壊的変更に対応するまでは 0.24.0 に固定する。",
      "matchPackageNames": ["org.eclipse.lsp4j:org.eclipse.lsp4j"],
      "enabled": false
    }
  ]
}
